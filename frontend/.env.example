VITE_API_BASE_URL=http://localhost:8787

# Optional. Microsoft Clarity project id, from clarity.microsoft.com. Leave it
# unset locally: with no id the tag is never injected, so dev sessions stay out
# of the dashboard. Production gets it from the github-pages Environment.
VITE_CLARITY_PROJECT_ID=

# Required. Clerk publishable key (pk_test_... in dev, pk_live_... in prod).
# Run `npx clerk@latest auth login` then `npx clerk@latest env pull` to fill it
# in, or copy it from dashboard.clerk.com. Safe to expose to the browser.
VITE_CLERK_PUBLISHABLE_KEY=
