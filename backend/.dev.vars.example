# Copy to .dev.vars for local development. Never commit the real values.
# In production each of these is a Worker secret; see the "Create Worker
# secrets file" step in .github/workflows/deploy.yml for how they get there.

# npx wrangler secret put ADMIN_TOKEN
ADMIN_TOKEN="local-dev-admin-token"

# Comma-separated addresses that get users.is_admin, which is what lets a Clerk
# session stand in for ADMIN_TOKEN on the admin panel. Reconciled on every
# upsert, so adding an address here grants it on that person's next sign-in.
# A secret rather than a wrangler.jsonc var because this repo is public.
# npx wrangler secret put ADMIN_EMAILS
ADMIN_EMAILS="you@example.com"

# Signing secret for the Clerk webhook that keeps the users table in step.
# dashboard.clerk.com -> Webhooks -> the endpoint -> Signing Secret.
CLERK_WEBHOOK_SIGNING_SECRET="whsec_..."

# Clerk backend API key, from dashboard.clerk.com -> API keys. Fetches the JWKS
# that verifies the session tokens the frontend sends as
# `Authorization: Bearer <jwt>`. `npx clerk@latest env pull` writes this for you.
CLERK_SECRET_KEY="sk_test_..."

# Razorpay key id. Not a secret -- it reaches the browser in the Checkout
# options -- but it lives here so the API is the single place that knows it.
# dashboard.razorpay.com -> Account & Settings -> API Keys.
RAZORPAY_KEY_ID=<value>

# Razorpay key secret. Signs nothing that leaves the Worker: it authenticates
# the Orders/Refunds calls and verifies the Checkout callback signature. This
# one must never reach the frontend.
RAZORPAY_KEY_SECRET=<value>
