{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ratemycards-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-29",
  // @clerk/backend reaches for Node built-ins on its way to Web Crypto.
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "api-ratemycards.manishbisht.me",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  // Drives type generation and *warns* on a missing secret in local dev -- it
  // does not fail a deploy. What actually keeps a deployment from coming up
  // with writes unguarded is the "Create Worker secrets file" step in
  // .github/workflows/deploy.yml, which throws before `deploy` is reached.
  // Keep that step if you ever rework this.
  "secrets": {
    "required": [
      "ADMIN_TOKEN",
      "CLERK_WEBHOOK_SIGNING_SECRET",
      // Fetches Clerk's JWKS, which is what verifies a session token.
      "CLERK_SECRET_KEY",
      // Authenticates the Razorpay Orders/Refunds calls and verifies the
      // Checkout callback signature.
      "RAZORPAY_KEY_ID",
      "RAZORPAY_KEY_SECRET"
    ]
  },
  "vars": {
    // CORS allowlist: production frontend, Vite dev server, then Vite preview.
    "ALLOWED_ORIGINS": "https://ratemycards.manishbisht.me,http://localhost:5173,http://localhost:4173"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ratemycards",
      // Local dev and tests ignore this value -- Miniflare keys off the binding
      // -- so only `--remote` (and therefore CI) dereferences it.
      "database_id": "91e9ca3f-d61a-47d2-b9cd-73989ebb4f10",
      "migrations_dir": "migrations"
    }
  ]
}
